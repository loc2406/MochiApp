# EXAMPLE ONLY: replace hostname and configure HTTPS certificates separately.
# Assumes the handover root has been installed as /opt/mochii.
server {
    listen 80;
    server_name YOUR-HOST;

    location = /mochi { return 302 /mochi/; }
    location /mochi/ {
        alias /opt/mochii/01-release/web/;
        index index.html;
        add_header Cache-Control "no-cache" always;
    }
    location /downloads/ {
        alias /opt/mochii/01-release/android/;
        add_header Content-Disposition "attachment";
    }
    location = /presentation { return 302 /presentation/; }
    location /presentation/ {
        alias /opt/mochii/04-presentation/;
        index index.html;
    }
    location /mochi-ai/ {
        client_max_body_size 8m;
        proxy_pass http://127.0.0.1:8897;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 90s;
        proxy_buffering off;
    }
    location / { return 404; }
}
