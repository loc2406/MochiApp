[Unit]
Description=Mochii AI Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mochii
Group=mochii
WorkingDirectory=/opt/mochii/02-source/ai-gateway
EnvironmentFile=/etc/mochii/gateway.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
